struct Rec {
    [Rec] rec,
};

enum Option {
    Some(int),
    Nyet,
};

let x: Rec = Rec {
    rec: [],
};

let y: Option = Option::Nyet;
let z: Option = Option::Some(0);

fun int match_option(Option opt) {
    ret match<Option> opt {
        Some(a) => {
            ret a;
        },
        Nyet => {
            ret -2;
        },
    };
};

print<int>(match_option(Option::Some(5)));

print<int>(match_option(Option::Nyet));
